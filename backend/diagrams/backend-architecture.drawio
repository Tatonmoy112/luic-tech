  <diagram id="cancellation-return-refund" name="7 Cancellation return refund">
    <mxGraphModel fold="1" pageWidth="1800" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1600" dy="1100" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Cancellation, physical returns and financial refunds • independent linked lifecycles" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#e1d5e7;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="30" width="1680" height="70" />
        </mxCell>
        <mxCell id="cancel" value="Cancellation request&#xA;Actor + order + reason + idempotency&#xA;Unique active request and history" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="160" width="460" height="120" />
        </mxCell>
        <mxCell id="guard" value="Coordinator locks order and relevant roots&#xA;Recheck dispatch, payment, stock and policy" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="350" width="460" height="120" />
        </mxCell>
        <mxCell id="hold" value="Paid / unknown: on_hold + finance work&#xA;Unpaid safe: release once and cancel&#xA;Dispatched: reject or route to return" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="550" width="460" height="140" />
        </mxCell>
        <mxCell id="cancelEnd" value="Guarded final cancellation&#xA;Approved request alone is insufficient&#xA;Resolve required refund and unshipped allocation&#xA;History / audit / event / destinations" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="830" width="460" height="160" />
        </mxCell>
        <mxCell id="ret" value="Return request and approval&#xA;Purchased-line quantity and return window&#xA;Ownership + cumulative prior quantity" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="610" y="160" width="460" height="120" />
        </mxCell>
        <mxCell id="inspect" value="T07 receipt / inspection&#xA;Lock order, positions, return and lines&#xA;Record disposition and evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="610" y="350" width="460" height="120" />
        </mxCell>
        <mxCell id="restock" value="Sellable disposition&#xA;One stock movement + position update&#xA;Damaged / quarantined: no sellable increase" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="610" y="550" width="460" height="140" />
        </mxCell>
        <mxCell id="returnEnd" value="Return resolution&#xA;Append return history / audit / outbox&#xA;Refund remains an independent authorized decision" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#667788;">
          <mxGeometry as="geometry" x="610" y="830" width="460" height="160" />
        </mxCell>
        <mxCell id="refund" value="Refund approval T08&#xA;Payment-wide and original line/component caps&#xA;Reserve balance; pre-dispatch finance hold&#xA;Order lock serializes approval and dispatch" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1180" y="160" width="460" height="120" />
        </mxCell>
        <mxCell id="submit" value="Claim durable refund submission intent&#xA;Commit before remote provider call&#xA;Stable reference; fenced worker claim" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1180" y="350" width="460" height="120" />
        </mxCell>
        <mxCell id="unknown" value="Unknown outcome&#xA;Keep refund balance reserved&#xA;Query stable reference; no safe lookup means finance/provider resolution" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f8cecc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1180" y="550" width="460" height="140" />
        </mxCell>
        <mxCell id="complete" value="Verified final result T09&#xA;Success: reserved -&gt; completed once&#xA;Verified terminal failure: policy release&#xA;History / audit / event / settlement evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1180" y="830" width="460" height="160" />
        </mxCell>
        <mxCell id="rules" value="All network calls occur outside commerce transactions. Dispatch and cancellation share the order lock. Refund totals cannot exceed verified paid balance. Return inspection does not automatically refund, and refund completion does not restock. Lease expiry never proves a financial call was not sent." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="1170" width="1680" height="140" />
        </mxCell>
