  <diagram id="search-reindex" name="8 Search projection reindex">
    <mxGraphModel fold="1" pageWidth="1800" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1600" dy="1100" gridSize="10" pageScale="1" page="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Search consistency and reindex • PostgreSQL authority / disposable search projection" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#e1d5e7;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="30" width="1680" height="70" />
        </mxCell>
        <mxCell id="facts" value="Catalog / price / media / stock commit&#xA;Outbox event + fixed destination rows&#xA;Independent source aggregate versions" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="160" width="490" height="125" />
        </mxCell>
        <mxCell id="request" value="Projection-request consumer&#xA;Receipt + desired-generation increment&#xA;One product / concrete-index row per target" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="650" y="160" width="490" height="125" />
        </mxCell>
        <mxCell id="claim" value="Claim projection row&#xA;Read generation and public facts in one&#xA;short consistent database snapshot" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1260" y="160" width="460" height="125" />
        </mxCell>
        <mxCell id="index" value="Close DB transaction, then index&#xA;Strict external generation version&#xA;Document or persistent tombstone" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1260" y="410" width="460" height="125" />
        </mxCell>
        <mxCell id="applied" value="Fence applied-generation update&#xA;Confirm stored generation on conflict&#xA;If desired is newer, schedule next pass" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#667788;">
          <mxGeometry as="geometry" x="650" y="410" width="490" height="125" />
        </mxCell>
        <mxCell id="query" value="Public queries and autocomplete&#xA;Cached candidates -&gt; bounded DB publication filter&#xA;API responses no-store under strict policy&#xA;Checkout rereads stock and money" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="410" width="490" height="125" />
        </mxCell>
        <mxCell id="register" value="Reindex job: register replacement&#xA;All request consumers fan out to live + rebuild&#xA;Checkpointed full identity backfill" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="730" width="490" height="140" />
        </mxCell>
        <mxCell id="catchup" value="Catch up and verify&#xA;Desired = applied; schema, counts,&#xA;publication and representative queries&#xA;Durable job progress / fenced worker" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#667788;">
          <mxGeometry as="geometry" x="650" y="730" width="490" height="140" />
        </mxCell>
        <mxCell id="switch" value="Switch read alias after gate&#xA;Keep old index current for rollback window&#xA;Audit and later retire old target" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#667788;">
          <mxGeometry as="geometry" x="1260" y="730" width="460" height="140" />
        </mxCell>
        <mxCell id="rules" value="Never compare a stock version to a product or price version. Index name is part of the projection-state primary key. No network call occurs inside the snapshot transaction. Persistent tombstones prevent a delayed older write from resurrecting an archived product. DB publication filtering covers normal indexing lag." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#667788;">
          <mxGeometry as="geometry" x="40" y="1110" width="1680" height="150" />
        </mxCell>
