          <mxGeometry x="1080" y="130" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="SQS Standard queue&#xA;may duplicate/reorder" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="recv" value="Worker receives and validates envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="340" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Reload current authority&#xA;check receipt/version/state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="340" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="Local effect or durable external-call intent&#xA;commits with consumer receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="330" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="external" value="Claim external-call intent&#xA;call outside transaction -&gt; record result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ack" value="Delete only after durable success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="Repeated permanent failure -&gt; DLQ&#xA;review • approve • bounded replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="560" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="unknown" value="Unknown provider outcome:&#xA;retain state; query by stable reference&#xA;no safe lookup: finance/provider review&#xA;lease expiry never licenses blind resend" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="safety" value="Publish succeeded but marking failed can republish.&#xA;Worker crash before delete can redeliver.&#xA;Dedupe and current-state guards make both safe." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
