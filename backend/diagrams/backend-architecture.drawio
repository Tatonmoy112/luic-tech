        <mxCell id="edge6" value="" edge="1" parent="1" source="restock" target="returnEnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=0;strokeColor=#667788;">
