  <diagram id="6securityboundaries" name="6 Security boundaries">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="stitle" value="Backend trust and authorization boundaries" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="untrusted" value="Untrusted zone&#xA;browser • bots • provider traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge2" value="Edge admission&#xA;TLS • WAF • route • size • coarse rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="web2" value="Optional frontend session boundary&#xA;API clients use verified bearer tokens&#xA;cookie clients require CSRF controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="120" width="280" height="100" as="geometry" />
