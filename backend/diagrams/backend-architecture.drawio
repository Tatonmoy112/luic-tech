        <mxCell id="qtitle" value="Transactional outbox and duplicate-safe worker flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
