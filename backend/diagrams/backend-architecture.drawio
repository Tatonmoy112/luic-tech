        <mxCell id="external2" value="Approved external egress&#xA;Auth0 • SSLCOMMERZ • email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ops3" value="Named operator access&#xA;MFA • least privilege • break-glass • audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="principle" value="A valid token proves identity evidence only.&#xA;Each use case checks active application account, current grant, target ownership/scope, aggregate state, amount threshold, and separation rule." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="560" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="redact" value="Secrets and raw PII are excluded from source, events, logs, traces and fixtures.&#xA;Necessary customer/order PII is restricted in designated business columns; provider evidence is bounded and redacted." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="560" width="360" height="100" as="geometry" />
