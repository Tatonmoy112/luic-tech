          <mxGeometry x="1100" y="105" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="private" value="Private workload zone&#xA;API and isolated worker roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="330" width="330" height="100" as="geometry" />
