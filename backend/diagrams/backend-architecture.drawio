          <mxGeometry x="1400" y="110" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Submit confirmed quote + Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="T02 atomic transaction&#xA;revalidate • reserve • snapshot order • attempt • audit • outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Commit pending order" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="240" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Claim persisted initiation intent&#xA;Create hosted session outside transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="240" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Redirect to gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="240" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="IPN arrives&#xA;persist deduped redacted receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Validate with provider server API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="Store immutable validation evidence" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="T04 verified result&#xA;record success; resolve uncertainty hold&#xA;check excess / terminal / other holds&#xA;then allocate once if eligible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="420" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="Confirm or hold order&#xA;excess payment -&gt; exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="420" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="race" value="Expiry releases due unallocated stock once; unknown money keeps the order held.&#xA;Late success checks terminal / coupon / risk / excess before allocation.&#xA;Already-paid stock holds use a separate authorized resolution command; callback replay remains a no-op." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="650" width="570" height="195" as="geometry" />
        </mxCell>
        <mxCell id="truth" value="Only verified server evidence changes payment state.&#xA;Callback may win the session-result race; later response cannot downgrade success or expose an ineligible payment URL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="650" width="500" height="145" as="geometry" />
