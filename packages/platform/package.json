{
  "name": "@luic/platform",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@sentry/node": "10.73.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "express": "5.2.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    }
  },
  "typesVersions": {
    "*": {
      "configuration": [
        "dist/configuration.d.ts"
      ],
      "lifecycle": [
        "dist/lifecycle.d.ts"
      ]
    }
  }
}
